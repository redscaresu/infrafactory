{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyEveryServiceButEC2SSMSTS",
      "Effect": "Deny",
      "NotAction": [
        "ec2:*",
        "ssm:*",
        "sts:*"
      ],
      "Resource": "*",
      "Condition": {
        "ArnNotLike": {
          "aws:PrincipalArn": "arn:aws:iam::*:role/OrganizationAccountAccessRole"
        }
      }
    },
    {
      "Sid": "DenyEveryOtherRegion",
      "Effect": "Deny",
      "Action": "*",
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": "REGION"
        },
        "ArnNotLike": {
          "aws:PrincipalArn": "arn:aws:iam::*:role/OrganizationAccountAccessRole"
        }
      }
    }
  ]
}
