filters:
  and:
    - file.inFolder("stories")
    - file.ext == "md"
    - file.path != "stories/README.md"
properties:
  note.status:
    displayName: Status
  note.epic:
    displayName: Epic
  note.depends_on:
    displayName: Depends on
views:
  - type: table
    name: Board
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - epic
      - depends_on
  - type: table
    name: By epic
    groupBy:
      property: epic
      direction: ASC
    order:
      - file.name
      - status
      - depends_on
